  // All player damage is applied directly via applyDmg. No friendly-fire effectTypes.\
  // Coordinate system: ePos (0-3 enemy grid), pPos (0-3 player grid, world = pPos+GRID_SIZE).\
  const enemyUseCard = useCallback(\
    (cardName: string, ePos: Position, slot: number) => \{\
      const ai = AI_CARD[cardName];\
      if (!ai) return;\
      const pPos = playerPosRef.current;\
      const sameRow = ePos.y === pPos.y;\
