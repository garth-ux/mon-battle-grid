const generateTrainer = (): \{ name: string; team: EnemyDef[] \} => \{\
  const names = [\
    "RIVAL",\
    "ACE",\
    "MARSHAL",\
    "SCOUT",\
    "ENFORCER",\
    "WARDEN",\
    "TACTICIAN",\
  ];\
  const name = names[Math.floor(Math.random() * names.length)];\
  const pick = () => \{\
    const t =\
      ALL_TRAINER_TYPES[Math.floor(Math.random() * ALL_TRAINER_TYPES.length)];\
    const shuffled = [...t.allMoves].sort(() => Math.random() - 0.5);\
    const deck = shuffled.slice(0, Math.min(6, shuffled.length));\
    return \{\
      type: t.type,\
      emoji: t.emoji,\
      hp: Math.floor(t.hp * 1.5),\
      shootChance: Math.min(0.5, t.shootChance + 0.1),\
      speed: Math.max(3, t.speed - 1),\
      deck,\
    \};\
  \};\
  return \{ name, team: [pick(), pick()] \};\
\};\
