      <Character3D\
        x=\{opponentPos.x\}\
        y=\{opponentPos.y\}\
        emoji=\{enemyEmoji\}\
        isOpponent\
        stunned=\{opponentStunned > 0\}\
        animState=\{opponentAnimState\}\
