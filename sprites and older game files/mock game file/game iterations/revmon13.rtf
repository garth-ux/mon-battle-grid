      )\}\
      \{bombs.map((b, i) => (\
        <Sphere\
          key=\{`bo-$\{i\}`\}\
          position=\{[b.x, 0.3, b.y]\}\
          args=\{[0.25, 16, 16]\}\
          castShadow\
        >\
          <meshStandardMaterial color="#333333" />\
        </Sphere>\
      ))\}\
      \{delayBombs.map((b, i) => (\
        <group key=\{`db-$\{i\}`\} position=\{[b.x, 0.3, b.y]\}>\
