          side="opponent"\
        />\
      )\}\
      \{explosionEffects.map((e, i) => (\
        <Effect3D\
          key=\{`ef-$\{i\}`\}\
          x=\{e.x\}\
          y=\{e.y\}\
          type=\{e.effectType || "explosion"\}\
