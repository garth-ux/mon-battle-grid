          ttl=\{s.ttl\}\
        />\
      ))\}\
      \{punch && (\
        <Effect3D x=\{punch.x\} y=\{punch.y\} type="explosion" ttl=\{punch.ttl\} />\
      )\}\
      \{lasso && (\
