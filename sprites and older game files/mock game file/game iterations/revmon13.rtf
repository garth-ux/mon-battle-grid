            highlight = true;\
          return (\
            <Tile3D\
              key=\{`tile-$\{x\}-$\{y\}`\}\
              x=\{localX\}\
              y=\{y\}\
              isPlayerGrid=\{isPlayerGrid\}\
              color=\{isPlayerGrid ? "#ff4444" : "#4444ff"\}\
              highlight=\{highlight\}\
            />\
          );\
        \})\
      )\}\
