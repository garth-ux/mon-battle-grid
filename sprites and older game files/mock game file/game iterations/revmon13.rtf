const getMonsterName = (emoji: string): string | null => \{\
  if (emoji === "\uc0\u55357 \u56446 ") return "Grunt";\
  if (emoji === "\uc0\u55357 \u57321 ") return "Slime";\
  if (emoji === "\uc0\u55358 \u56711 ") return "Bat";\
  if (emoji === "\uc0\u55358 \u56608 ") return "Cowboy";\
  if (emoji === "\uc0\u55357 \u56320 ") return "RatKing";\
  if (emoji === "\uc0\u55358 \u56724 ") return "Hogglin";\
  return null;\
\};\
