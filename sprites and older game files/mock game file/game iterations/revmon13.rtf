  playerAnimState: "idle" | "attack" | "attack2" | "hit";\
  opponentAnimState: "idle" | "attack" | "attack2" | "hit";\
\}> = (props) => \{\
  const \{\
    playerPos,\
    opponentPos,\
    playerBullets,\
    opponentBullets,\
    blocks,\
    beams,\
    explosionEffects,\
    bombs,\
    delayBombs,\
    boomerang,\
    tractorBeam,\
    selectedCharacter,\
    opponentStunned,\
    isCharging,\
