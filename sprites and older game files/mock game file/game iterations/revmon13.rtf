                : "none",\
              transition: "filter 0.15s",\
            \}\}\
          />\
        </Html>\
      ) : (\
        <>\
          <Sphere args=\{[0.3, 16, 16]\} castShadow>\
            <meshStandardMaterial\
              color=\{\
                stunned\
                  ? "#808080"\
                  : frenzy\
                  ? "#00ff00"\
                  : isOpponent\
                  ? "#4444ff"\
                  : "#ff4444"\
              \}\
