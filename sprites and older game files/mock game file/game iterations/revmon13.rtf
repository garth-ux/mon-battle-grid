          ttl=\{t.ttl\}\
        />\
      ))\}\
      \{tongueWhipActive && (\
        <Effect3D\
          x=\{tongueWhipActive.x\}\
          y=\{tongueWhipActive.y\}\
          type="tonguewhip"\
          ttl=\{tongueWhipActive.ttl\}\
        />\
      )\}\
      \{slash.map((s, i) => (\
        <Effect3D\
          key=\{`sl-$\{i\}`\}\
          x=\{s.x\}\
          y=\{s.y\}\
